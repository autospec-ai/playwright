{
  "name": "@autospec-ai/action",
  "version": "2.1.1",
  "description": "AI-powered Playwright E2E test generation from commit diffs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/autospec-ai/playwright.git"
  },
  "bugs": {
    "url": "https://github.com/autospec-ai/playwright/issues"
  },
  "homepage": "https://github.com/autospec-ai/playwright#readme",
  "main": "dist/index.mjs",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:main": "node scripts/build.mjs main",
    "build:post": "node scripts/build.mjs post",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:coverage": "jest --coverage --collectCoverageFrom='src/**/*.ts'",
    "test:dist": "node scripts/smoke-dist.mjs",
    "dev": "tsx src/main.ts",
    "setup-hooks": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "@actions/artifact": "^6.2.1",
    "@actions/core": "^3.0.0",
    "@actions/exec": "^3.0.0",
    "@actions/github": "^9.0.0",
    "@anthropic-ai/sdk": "^0.30.0",
    "glob": "^10.3.10",
    "minimatch": "^9.0.3",
    "openai": "^4.60.0",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "@types/node": "^24.10.0",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "esbuild": "^0.28.2",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "tsx": "^4.20.6"
  },
  "license": "MIT"
}
