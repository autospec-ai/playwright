{
  "name": "@autospec-ai/action",
  "version": "2.1.2",
  "description": "AI-powered Playwright E2E test generation from commit diffs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/autospec-ai/playwright.git"
  },
  "bugs": {
    "url": "https://github.com/autospec-ai/playwright/issues"
  },
  "homepage": "https://github.com/autospec-ai/playwright#readme",
  "main": "dist/index.mjs",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:main": "node scripts/build.mjs main",
    "build:post": "node scripts/build.mjs post",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:coverage": "jest --coverage --collectCoverageFrom='src/**/*.ts'",
    "test:dist": "node scripts/smoke-dist.mjs",
    "dev": "tsx src/main.ts",
    "setup-hooks": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "@actions/artifact": "^6.2.1",
    "@actions/core": "^3.0.0",
    "@actions/exec": "^3.0.0",
    "@actions/github": "^9.0.0",
    "@anthropic-ai/sdk": "^0.126.0",
    "glob": "^13.0.6",
    "minimatch": "^10.2.6",
    "openai": "^7.19.0",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.2",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.15"
  },
  "license": "MIT"
}
